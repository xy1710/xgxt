{
  "name": "server-job",
  "version": "1.0.0",
  "description": "学管系统 · 就业管理 后端服务（Express + TypeScript）",
  "main": "dist/app.js",
  "scripts": {
    "predev": "cd ../shared-types && npm run build",
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "migrate": "knex migrate:latest && knex migrate:latest --env edu && knex migrate:latest --env class && knex migrate:latest --env class-common && knex migrate:latest --env class-jh",
    "migrate:job": "knex migrate:latest",
    "migrate:edu": "knex migrate:latest --env edu",
    "migrate:class": "knex migrate:latest --env class && knex migrate:latest --env class-common",
    "migrate:class-jh": "knex migrate:latest --env class-jh",
    "migrate:list": "knex migrate:list",
    "migrate:rollback": "knex migrate:rollback",
    "seed:demo": "node scripts/seed-demo.mjs",
    "seed:demo:clean": "node scripts/seed-demo.mjs clean",
    "seed:portal": "node scripts/seed-portal-accounts.mjs",
    "seed:portal:clean": "node scripts/seed-portal-accounts.mjs clean",
    "seed:class-jh": "node scripts/seed-class-jh-demo.js",
    "seed:class-job": "node scripts/seed-class-job-demo.mjs",
    "seed:all": "node scripts/seed-all-demo.mjs",
    "seed:all:dry": "node scripts/seed-all-demo.mjs --dry",
    "seed:teaching": "node scripts/seed-teaching-demo.mjs",
    "seed:teaching:dry": "node scripts/seed-teaching-demo.mjs --dry",
    "fix:perm": "node scripts/fix-perm-accounts.mjs",
    "seed:perm-pages": "tsx scripts/seed-perm-pages.ts",
    "check:action-overlay": "tsx scripts/check-action-overlay.ts",
    "uni:migrate:plan": "tsx scripts/uni-migrate.ts --plan",
    "uni:migrate": "tsx scripts/uni-migrate.ts --run",
    "uni:migrate:verify": "tsx scripts/uni-migrate.ts --verify"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "multer": "^2.4.0",
    "mysql2": "^3.9.7",
    "shared-types": "file:../shared-types",
    "sharp": "^0.35.5",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^6.0.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.12.7",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
