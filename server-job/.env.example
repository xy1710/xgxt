# ============================================================
# 后端服务环境变量配置（统一门户版）
#
# ⚠️ 使用方法：
#    1. 复制这个文件，改名为 .env（去掉 .example）
#    2. 只需改【下面标注了「你要改」】的那几项
#    3. .env 不要提交到 git！（它包含密码）
#
# ★ 2026-10-05 深度单体合并：
#    原「门户 8000 / 咨询 8001 / 财务 8005 / 权限 8006」四个独立服务
#    已全部并入本服务（8004）。所以下面所有 *_URL 都指向 8004，
#    四个新模块的库也各自独立（sms_portal / sms_consult / sms_finance / sms_perm）。
# ============================================================

# ---------- 本服务端口 ----------
# ⚠️ 合并后全系统只有这一个后端端口。
PORT=8004

NODE_ENV=development

# ---------- 数据库 ----------
# ⚠️ 【你要改】DB_PASSWORD：填你本机 MySQL 的 root 密码
#    其余三项通常不用动（除非你的库不在本机）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGE_ME

# ⚠️ 库名对照表（必须和你实际建的库名一模一样，共 9 个）：
#   sms_job / sms_edu / sms_class / sms_class_jh / sms_common
#   / sms_portal / sms_consult / sms_finance / sms_perm
DB_NAME=sms_job

# 教务库（就业的数据在 sms_job，教务的数据在 sms_edu）
DB_NAME_EDU=sms_edu

# 班级库（大学部）+ 公共库（字典/选项）
DB_NAME_CLASS=sms_class
DB_NAME_COMMON=sms_common

# ★ 教学管理（初高）库（2026-10-05 并入，与上面的大学部【分库】）
# ⚠️ 这一行不能漏：npm run migrate 会连带跑 `knex --env class-jh`，
#    knexfile.js 里那个 env 用的是 requireEnv('DB_NAME_CLASS_JH')，
#    读不到会直接抛「数据库配置缺失：DB_NAME_CLASS_JH」，整个 migrate 中断。
DB_NAME_CLASS_JH=sms_class_jh

# ---------- ★ 合并进来的四个新模块的库（各自独立，勿混用）----------
#   portal  = 统一门户 / 登录 / 统一账号表
#   consult = 市场咨询
#   finance = 财务管理
#   perm    = 权限管理（全系统权限的权威源）
DB_NAME_PORTAL=sms_portal
DB_NAME_CONSULT=sms_consult
DB_NAME_FINANCE=sms_finance
DB_NAME_PERM=sms_perm

# ---------- JWT（门户登录签发，各模块验签）----------
# ⚠️ 门户签发的 token 要给各业务模块验签，secret 必须一致。
#    合并到同一个进程后，这里一处配置即可全系统生效。
JWT_SECRET=CHANGE_ME_USE_A_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# ---------- 其他服务的地址（跨模块调用用）----------
# ★ 合并后各模块都在同一个进程（8004），所以这里统一指向 8004。
AUTH_URL=http://localhost:8004
EDU_URL=http://localhost:8004
CLASS_URL=http://localhost:8004
JOB_URL=http://localhost:8004
FINANCE_URL=http://localhost:8004
PERM_URL=http://localhost:8004
STAT_URL=http://localhost:8004

# 门户前端入口（合并后前端只有一个 5173，这里留作展示用）
# ⚠️ 切勿在此处定义任何 *_URL（尤其 FINANCE_URL）——同名 key 会覆盖上面的正确值。
CONSULT_URL=http://localhost:8004
PORTAL_URL=http://localhost:8004

# ---------- 内部服务令牌（咨询 → 权限的登录链路用）----------
# ⚠️ 【你要改】填一个随机串。
#    这个令牌用于服务间调用（/sync、/push 等内部接口），不配也能跑
#    （代码里有个占位符兜底），但那等于用公开的占位符当凭证，务必替换。
INTERNAL_TOKEN=CHANGE_ME_USE_A_RANDOM_TOKEN

# ---------- 默认账号初始密码（可选）----------
# 管理员在「权限管理」里新增账号时，如果没填密码就用这个值。
# 不配则用内置演示默认值（与 README 里公开的演示账号密码一致）。
# 生产环境建议：在这里换成随机串，或让前端把密码设为必填。
DEFAULT_ACCOUNT_PASSWORD=

# ---------- 上传目录 ----------
# 合并后 uploads 已统一到 server-job/uploads，不再需要跨目录双写 → 留空
FINANCE_UPLOAD_DIR=
